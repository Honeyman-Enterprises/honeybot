# Honeybot environment schema (Varlock source-of-truth).
#
# Commit this file. It contains NO secret values \u2014 only references into 1Password.
# At runtime, `varlock run -- <cmd>` resolves every op(...) reference using
# OP_SERVICE_ACCOUNT_TOKEN (provided via process env), validates against this
# schema, and exports the resolved values to the child process only.

# ---- Header: plugin registration --------------------------------------------
# @defaultRequired=false
# @defaultSensitive=false
# @plugin(@varlock/1password-plugin@0.3.5)
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN)
# ---
# Note on @defaultRequired=false: optional-by-default, opt in via @required.
# Previously this was `infer`, which classified every var without an explicit
# override as required and took the bot down whenever any single optional
# integration (Exa, Brave, Tavily, Sentry, Fal, Mercury, Honcho, ...) had an
# empty placeholder in 1Password — directly contradicting the "All optional
# until the corresponding MCP server is wired" comment on the MCP section.
# A missing optional credential should disable that one skill, not refuse
# to launch hermes. Genuinely required vars are marked @required below
# (Anthropic, Mem0, Slack bot/app, AWS keys, ES, Neo4j, OP token).

# ---- 1Password service account token ----------------------------------------
# Consumed from process env (./op.env via docker compose env_file — same
# path in local dev and on EC2; gitignored, dockerignored, chmod 600).
# Varlock marks @type=opServiceAccountToken as @sensitive automatically.
# @type=opServiceAccountToken @required
OP_SERVICE_ACCOUNT_TOKEN=

# ---- Core -------------------------------------------------------------------

# @type=enum(dev,staging,prod)
APP_ENV=dev

# @type=enum(debug,info,warn,error)
LOG_LEVEL=info

# ---- Anthropic --------------------------------------------------------------

# @sensitive @required
ANTHROPIC_API_KEY=op("op://Honeybot/Anthropic API/api_key")

# ---- OpenAI -----------------------------------------------------------------
# Powers Hermes' auxiliary multimodal pipeline: image OCR / image
# understanding for inbound Slack/Telegram/iMessage attachments,
# vector embeddings, and any tool that resolves vision via
# `agent/auxiliary_client.py::resolve_vision_provider_client`.
#
# The main chat model stays Anthropic — Claude has native vision and is
# the first-choice path. OpenAI is the secondary backend the auxiliary
# router falls back to (see hermes-agent's vision auto-detect order),
# and the explicit override target if/when we want GPT-4o for OCR-heavy
# images.
#
# Optional: missing key disables the OpenAI fallback only; Claude vision
# continues to work through ANTHROPIC_API_KEY.
# @sensitive
OPENAI_API_KEY=op("op://Honeybot/OpenAI/key")

# ---- Mem0 -------------------------------------------------------------------
# Long-term memory provider for Hermes. The provider is selected at image
# build time (`hermes config set memory.provider mem0` in the Dockerfile);
# this key is what lets the running container talk to api.mem0.ai.
# See https://hermes-agent.nousresearch.com/docs/user-guide/features/memory-providers
# @sensitive @required
MEM0_API_KEY=op("op://Honeybot/Mem0/key")

# ---- Slack (Socket Mode) ----------------------------------------------------

# Bot token (starts with xoxb-)
# @sensitive @required
SLACK_BOT_TOKEN=op("op://Honeybot/Slack Bot/bot_token")

# App-level token with connections:write scope (starts with xapp-)
# @sensitive @required
SLACK_APP_TOKEN=op("op://Honeybot/Slack Bot/app_token")

# Signing secret \u2014 not strictly needed for Socket Mode, kept for future HTTP events.
# @sensitive
SLACK_SIGNING_SECRET=op("op://Honeybot/Slack Bot/signing_secret")

# Comma-separated Slack user IDs allowed to DM the bot. Michelle's UID goes here.
# Hermes reads this exact env var name (see gateway/run.py:2679).
# @required
SLACK_ALLOWED_USERS=op("op://Honeybot/Slack Bot/allowed_user_ids")

# Hermes default is true, which requires @-mentions even in DMs — that silently
# drops all DM traffic. Source: gateway/platforms/slack.py:1684. Set false so
# Michelle can DM the bot without typing "@honeybot" every time.
# @type=enum(true,false)
SLACK_REQUIRE_MENTION=false

# Channel ID where Hermes delivers cron job results, cross-platform messages,
# and any other proactive (non-reply) traffic. Read by the gateway via
# os.getenv("SLACK_HOME_CHANNEL") — see gateway/config.py:924 and the nag
# message at gateway/run.py:4444 that fires on every fresh history when this
# is unset. Storing the channel ID in 1Password (rather than hardcoding) so
# rotating to a different channel is a vault edit, not a redeploy.
SLACK_HOME_CHANNEL=op("op://Honeybot/Slack Bot/home_channel")

# ---- AWS (bot-level, pre-per-user) ------------------------------------------
# NOTE: This is the bot-level AWS credential path, shared across all Slack
# users who DM the bot. The skills/aws/SKILL.md design calls for per-user
# credentials at op://Honeybot/AWS-{SlackUserID}/... — this bot-level path
# is the convenience variant used while Honeybot is single-user (Eric only).
# When Michelle (or anyone else) starts using the bot, migrate to the per-
# user pattern and remove these three vars.
#
# The IAM user behind these keys should have: Route53, EC2 (includes SG),
# S3, CloudFront — all FullAccess. See docs/identity-model.md for the
# per-user rationale and skills/aws/SKILL.md §"Connect flow" for the
# migration target.
#
# @sensitive @required
AWS_ACCESS_KEY_ID=op("op://Honeybot/AWS/access_key_id")
# @sensitive @required
AWS_SECRET_ACCESS_KEY=op("op://Honeybot/AWS/secret_access_key")
# @required
AWS_DEFAULT_REGION=op("op://Honeybot/AWS/default_region")

# ---- HubSpot (bot-level, legacy v1) -----------------------------------------
# NOTE: This is the legacy v1 HubSpot credential path, shared across all
# Slack users. Pending migration to the per-user identity model described in
# docs/identity-model.md, where HubSpot PAKs live at
#   op://Honeybot/HubSpot-{SlackUserID}/personal_access_key
# and are read at tool-invocation time via skills/_lib/creds.sh, NOT via
# varlock pre-resolution. This bot-level var is kept until the current
# install-and-auth flow is verified end-to-end, then removed.
#
# @sensitive
HUBSPOT_PERSONAL_ACCESS_KEY=op("op://Honeybot/HubSpot/personal_access_key")

# ---- Elasticsearch (internal only) ------------------------------------------
# Password for the built-in `elastic` superuser. Generate once, store in
# 1Password, never rotate casually (rotation means downtime until every
# consumer is updated).
# @sensitive @required
ELASTIC_PASSWORD=op("op://Honeybot/Elasticsearch/password")

# ---- Neo4j (internal only) --------------------------------------------------
# Neo4j accepts auth as a single env var in "user/password" form (their
# convention). Stored as a single field in 1Password so rotating is one
# edit, not two.
# @sensitive @required
NEO4J_AUTH=op("op://Honeybot/Neo4j/auth")

# ---- Hermes OpenAI-compatible API server ------------------------------------
# Hermes ships an `api_server` gateway adapter that exposes the running
# agent at /v1/chat/completions, /v1/responses, /v1/runs, etc. — the same
# shape any OpenAI-compatible frontend (Open WebUI, LobeChat, LibreChat,
# AnythingLLM, ChatBox, NextChat, ...) speaks. We use it as the model
# backend for the openwebui service in docker-compose.yml.
#
# Wiring:
#   API_SERVER_ENABLED=true       turns the adapter on at gateway start
#   API_SERVER_HOST=0.0.0.0       listen on the container's honeynet IP
#                                  (NOT loopback — sibling containers
#                                  need to reach it)
#   API_SERVER_PORT=8642          Hermes' canonical default; nothing in
#                                  honeynet collides
#   API_SERVER_KEY=<bearer>       mandatory once the host isn't 127.0.0.1
#                                  — see hermes-agent docs/user-guide/
#                                  api-server.md. Generated once on first
#                                  container boot by seed-vault.sh and
#                                  read here from 1Password.
#   API_SERVER_CORS_ORIGINS=...   allowlist for browser-side fetches.
#                                  Open WebUI proxies API calls through
#                                  its own backend (so CORS isn't on the
#                                  hot path) but we set it for any future
#                                  direct-from-browser client.
#
# This adapter is INTERNAL ONLY — never expose it to the host or the
# internet. nginx routes the public `/` path on apex to openwebui:8080,
# and openwebui's backend is the only thing that talks to honeybot:8642.
# Putting `ports:` on the honeybot service for 8642 would be a security
# regression — leave it on honeynet.
#
# @type=enum(true,false)
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
# @sensitive @required
API_SERVER_KEY=op("op://Honeybot/HermesAPI/key")
# Comma-separated. Trailing slashes get normalized away inside Hermes'
# config loader, so https://honeybot.honeymanenterprises.com is enough.
API_SERVER_CORS_ORIGINS=https://honeybot.honeymanenterprises.com

# ---- Open WebUI -------------------------------------------------------------
# Web frontend for the api_server adapter above. Runs in its own
# container (`openwebui` in docker-compose.yml), terminates at nginx on
# the apex, and uses Hermes as its sole model provider.
#
# Open WebUI maintains its OWN user-account database (sqlite under
# /app/backend/data on the openwebui-data named volume). That's separate
# from the Slack allowlist — first user to sign up at the public URL
# becomes the local admin. Set OPENWEBUI_SIGNUP_ENABLED=false in
# docker-compose.yml after the admin account is created (or leave it
# true if you want to invite collaborators by URL).
#
# WEBUI_SECRET_KEY signs Open WebUI's own session JWTs. Auto-generated
# on first vault seed; never expose, never log. Rotating it logs out
# every Open WebUI user — do it deliberately, not casually.
# @sensitive @required
OPENWEBUI_SECRET_KEY=op("op://Honeybot/OpenWebUI/secret_key")

# ---- SMTP (Workspace relay) -------------------------------------------------
# Outbound mail surface for honeybot. Primary use case is the
# cross-provider identity-linking flow: when a user attaches a new auth
# provider (Google, GitHub, Microsoft, …) to an existing profile, we
# verify they actually own the email that provider asserted by sending
# a one-time link to it. See docs/email-verification.md for the full
# flow + L3 contract. Open WebUI's account-recovery path is a downstream
# consumer of the same relay (and validates host+port+user+password+from
# at its own runtime), but it's not the reason this exists.
#
# Every consumer reads these env names; nobody invents their own.
# Every send routes through skills/_lib/send_email.py (or the shell
# wrapper send-email.sh). Don't reach into op:// or smtplib directly.
#
# Backend: Google Workspace SMTP relay (smtp-relay.gmail.com:587, STARTTLS).
# Auth: an app password generated by a Workspace user with 2-Step on. The
# MAIL FROM address (noreply@…) does NOT need to be a real Workspace user —
# the relay accepts any address in our verified domains.
#
# All six values are OPTIONAL at the schema level. send_email.send()
# raises SMTPNotConfigured when any of host/port/username/password/
# mail_from is empty, and every consumer is required to handle that as
# "feature off" (a clear user-facing message, not a stack trace).
# This is deliberate — making them @required at the schema layer would
# re-introduce the bring-up failure we hit in commit 1f51797 (SMTP item
# missing from 1Password vault → every @required SMTP_* ref failed
# itemNotFound → varlock refused to launch the bot, even on hosts that
# don't need outbound mail at all).
#
# When you want outbound mail: fill all 6 fields in op://Honeybot/SMTP/
# (a placeholder item is auto-created by scripts/seed-vault.sh on first
# boot — see the SMTP section there for the click-path).
SMTP_HOST=op("op://Honeybot/SMTP/host")
SMTP_PORT=op("op://Honeybot/SMTP/port")
SMTP_USERNAME=op("op://Honeybot/SMTP/username")
# @sensitive
SMTP_PASSWORD=op("op://Honeybot/SMTP/app_password")
SMTP_MAIL_FROM=op("op://Honeybot/SMTP/mail_from")
SMTP_MAIL_FROM_NAME=op("op://Honeybot/SMTP/mail_from_name")

# ---- MCP API keys (Phase 5) -------------------------------------------------
# All optional until the corresponding MCP server is wired. Keys populated
# in 1Password when we start each phase; empty = MCP not enabled.

# @sensitive
EXA_API_KEY=op("op://Honeybot/Exa/api_key")

# @sensitive
BRAVE_SEARCH_API_KEY=op("op://Honeybot/Brave Search/api_key")

# @sensitive
TAVILY_API_KEY=op("op://Honeybot/Tavily/api_key")

# @sensitive
SENTRY_AUTH_TOKEN=op("op://Honeybot/Sentry/auth_token")

# @sensitive
FAL_KEY=op("op://Honeybot/Fal/api_key")

# ---- Mercury (Phase 5, custom MCP) ------------------------------------------
# Read-only Mercury API token. Treasury/payment scopes require their
# enterprise tier — we're not using those.
# @sensitive
MERCURY_API_TOKEN=op("op://Honeybot/Mercury/api_token")

# ---- Honcho (Phase 8, memory proxy) -----------------------------------------
# Honcho runs alongside Mem0 via the proxy-memory MCP. Empty until we
# stand up a Honcho instance.
# @sensitive
HONCHO_API_KEY=op("op://Honeybot/Honcho/api_key")
HONCHO_BASE_URL=op("op://Honeybot/Honcho/base_url")

# ---- Telegram (gateway, Phase 6) --------------------------------------------
# Bot token from @BotFather. Stored at op://Honeybot/Telegram/token per
# standard vault convention. Not yet wired into the gateway — wiring
# happens in a separate Phase 6 PR after nginx/webhook infra is up.
# @sensitive
TELEGRAM_BOT_TOKEN=op("op://Honeybot/Telegram/token")

# ---- BlueBubbles (iMessage gateway, Phase 9) --------------------------------
# Hermes' native BlueBubbles adapter exposes iMessage as a first-class
# gateway alongside Slack/Telegram. The relay (BlueBubbles Server) runs on
# the home Mac mini under organization@honeymanenterprises.com's iMessage
# account, reachable via DNS at imessage.relay.honeybot.honeymanenterprises.com.
#
# Topology:
#   Mac mini (BlueBubbles Server) ──webhook──► nginx (hooks.honeybot.*)
#                                                  └─► honeybot:8644
#                                                       (Hermes adapter)
#   honeybot ───outbound HTTP───► BLUEBUBBLES_SERVER_URL
#                                  (sends iMessages via relay's REST API)
#
# All keys here are @sensitive but NOT @required — missing keys disable the
# integration without crashing hermes (per the schema header note). When
# the Mac side is offline we just don't get inbound iMessages until it's
# back; the rest of the bot is unaffected.
#
# @sensitive
BLUEBUBBLES_SERVER_URL=op("op://Honeybot/BlueBubbles/server_url")
# @sensitive
BLUEBUBBLES_PASSWORD=op("op://Honeybot/BlueBubbles/password")

# Listener wiring. nginx/conf.d/honeybot.conf already proxies
# https://hooks.honeybot.honeymanenterprises.com/webhooks/* to honeybot:8644.
# These three values make Hermes' internal webhook server line up with
# that proxy: bind on the container's external interface (not loopback),
# use 8644 (not Hermes' default 8645) so we don't have to touch nginx,
# and respond on /webhooks/bluebubbles under the existing /webhooks/*
# namespace.
BLUEBUBBLES_WEBHOOK_HOST=0.0.0.0
BLUEBUBBLES_WEBHOOK_PORT=8644
BLUEBUBBLES_WEBHOOK_PATH=/webhooks/bluebubbles

# Allow any iMessage handle to DM the bot. The threat surface is "anyone
# who has the OrganizationHE iMessage handle (email or any linked phone
# number) gets a Hermes-powered conversation." For a small business
# address book this is acceptable; tighten via
#   BLUEBUBBLES_ALLOWED_USERS=user@icloud.com,+15551234567
# (comma-separated, exact match) if iMessage spam ever becomes a problem.
# Note: BLUEBUBBLES_PASSWORD authenticates the API channel between Hermes
# and the relay — it does NOT gate which iMessage senders are accepted,
# that's what these vars are for.
# @type=enum(true,false)
BLUEBUBBLES_ALLOW_ALL_USERS=true

# ---- Per-user credentials (NOT listed here) ---------------------------------
# Every credential that represents a human (Gmail, AWS, HubSpot post-migration,
# Slack user tokens, Google Calendar, ...) lives at
#   op://Honeybot/{Service}-{SlackUserID}/{field}
# and is fetched at tool-invocation time by skills/_lib/creds.sh using the
# Slack user ID of the requester. These do NOT appear in .env.schema because
# (a) they are dynamic per-user and (b) keeping them out of the varlock
# pre-resolution path is what makes cross-user access a hard error rather
# than a silent fallback. See docs/identity-model.md for the full rationale.
