# Honeybot environment schema (Varlock source-of-truth).
#
# Commit this file. It contains NO secret values \u2014 only references into 1Password.
# At runtime, `varlock run -- <cmd>` resolves every op(...) reference using
# OP_SERVICE_ACCOUNT_TOKEN (provided via process env), validates against this
# schema, and exports the resolved values to the child process only.

# ---- Header: plugin registration --------------------------------------------
# @defaultRequired=infer
# @defaultSensitive=false
# @plugin(@varlock/1password-plugin@0.3.5)
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN)
# ---

# ---- 1Password service account token ----------------------------------------
# Consumed from process env (./op.env via docker compose env_file — same
# path in local dev and on EC2; gitignored, dockerignored, chmod 600).
# Varlock marks @type=opServiceAccountToken as @sensitive automatically.
# @type=opServiceAccountToken @required
OP_SERVICE_ACCOUNT_TOKEN=

# ---- Core -------------------------------------------------------------------

# @type=enum(dev,staging,prod)
APP_ENV=dev

# @type=enum(debug,info,warn,error)
LOG_LEVEL=info

# ---- Anthropic --------------------------------------------------------------

# @sensitive @required
ANTHROPIC_API_KEY=op("op://Honeybot/Anthropic API/api_key")

# ---- Mem0 -------------------------------------------------------------------
# Long-term memory provider for Hermes. The provider is selected at image
# build time (`hermes config set memory.provider mem0` in the Dockerfile);
# this key is what lets the running container talk to api.mem0.ai.
# See https://hermes-agent.nousresearch.com/docs/user-guide/features/memory-providers
# @sensitive @required
MEM0_API_KEY=op("op://Honeybot/Mem0/key")

# ---- Slack (Socket Mode) ----------------------------------------------------

# Bot token (starts with xoxb-)
# @sensitive @required
SLACK_BOT_TOKEN=op("op://Honeybot/Slack Bot/bot_token")

# App-level token with connections:write scope (starts with xapp-)
# @sensitive @required
SLACK_APP_TOKEN=op("op://Honeybot/Slack Bot/app_token")

# Signing secret \u2014 not strictly needed for Socket Mode, kept for future HTTP events.
# @sensitive
SLACK_SIGNING_SECRET=op("op://Honeybot/Slack Bot/signing_secret")

# Comma-separated Slack user IDs allowed to DM the bot. Michelle's UID goes here.
# Hermes reads this exact env var name (see gateway/run.py:2679).
# @required
SLACK_ALLOWED_USERS=op("op://Honeybot/Slack Bot/allowed_user_ids")

# Hermes default is true, which requires @-mentions even in DMs — that silently
# drops all DM traffic. Source: gateway/platforms/slack.py:1684. Set false so
# Michelle can DM the bot without typing "@honeybot" every time.
# @type=enum(true,false)
SLACK_REQUIRE_MENTION=false

# ---- AWS (bot-level, pre-per-user) ------------------------------------------
# NOTE: This is the bot-level AWS credential path, shared across all Slack
# users who DM the bot. The skills/aws/SKILL.md design calls for per-user
# credentials at op://Honeybot/AWS-{SlackUserID}/... — this bot-level path
# is the convenience variant used while Honeybot is single-user (Eric only).
# When Michelle (or anyone else) starts using the bot, migrate to the per-
# user pattern and remove these three vars.
#
# The IAM user behind these keys should have: Route53, EC2 (includes SG),
# S3, CloudFront — all FullAccess. See docs/identity-model.md for the
# per-user rationale and skills/aws/SKILL.md §"Connect flow" for the
# migration target.
#
# @sensitive @required
AWS_ACCESS_KEY_ID=op("op://Honeybot/AWS/access_key_id")
# @sensitive @required
AWS_SECRET_ACCESS_KEY=op("op://Honeybot/AWS/secret_access_key")
# @required
AWS_DEFAULT_REGION=op("op://Honeybot/AWS/default_region")

# ---- HubSpot (bot-level, legacy v1) -----------------------------------------
# NOTE: This is the legacy v1 HubSpot credential path, shared across all
# Slack users. Pending migration to the per-user identity model described in
# docs/identity-model.md, where HubSpot PAKs live at
#   op://Honeybot/HubSpot-{SlackUserID}/personal_access_key
# and are read at tool-invocation time via skills/_lib/creds.sh, NOT via
# varlock pre-resolution. This bot-level var is kept until the current
# install-and-auth flow is verified end-to-end, then removed.
#
# @sensitive
HUBSPOT_PERSONAL_ACCESS_KEY=op("op://Honeybot/HubSpot/personal_access_key")

# ---- Elasticsearch (internal only) ------------------------------------------
# Password for the built-in `elastic` superuser. Generate once, store in
# 1Password, never rotate casually (rotation means downtime until every
# consumer is updated).
# @sensitive @required
ELASTIC_PASSWORD=op("op://Honeybot/Elasticsearch/password")

# ---- Neo4j (internal only) --------------------------------------------------
# Neo4j accepts auth as a single env var in "user/password" form (their
# convention). Stored as a single field in 1Password so rotating is one
# edit, not two.
# @sensitive @required
NEO4J_AUTH=op("op://Honeybot/Neo4j/auth")

# ---- MCP API keys (Phase 5) -------------------------------------------------
# All optional until the corresponding MCP server is wired. Keys populated
# in 1Password when we start each phase; empty = MCP not enabled.

# @sensitive
EXA_API_KEY=op("op://Honeybot/Exa/api_key")

# @sensitive
BRAVE_SEARCH_API_KEY=op("op://Honeybot/Brave Search/api_key")

# @sensitive
TAVILY_API_KEY=op("op://Honeybot/Tavily/api_key")

# @sensitive
SENTRY_AUTH_TOKEN=op("op://Honeybot/Sentry/auth_token")

# @sensitive
FAL_KEY=op("op://Honeybot/Fal/api_key")

# ---- Mercury (Phase 5, custom MCP) ------------------------------------------
# Read-only Mercury API token. Treasury/payment scopes require their
# enterprise tier — we're not using those.
# @sensitive
MERCURY_API_TOKEN=op("op://Honeybot/Mercury/api_token")

# ---- Honcho (Phase 8, memory proxy) -----------------------------------------
# Honcho runs alongside Mem0 via the proxy-memory MCP. Empty until we
# stand up a Honcho instance.
# @sensitive
HONCHO_API_KEY=op("op://Honeybot/Honcho/api_key")
HONCHO_BASE_URL=op("op://Honeybot/Honcho/base_url")

# ---- Telegram (gateway, Phase 6) --------------------------------------------
# Bot token from @BotFather. Stored at op://Honeybot/Telegram/token per
# standard vault convention. Not yet wired into the gateway — wiring
# happens in a separate Phase 6 PR after nginx/webhook infra is up.
# @sensitive
TELEGRAM_BOT_TOKEN=op("op://Honeybot/Telegram/token")

# ---- Per-user credentials (NOT listed here) ---------------------------------
# Every credential that represents a human (Gmail, AWS, HubSpot post-migration,
# Slack user tokens, Google Calendar, ...) lives at
#   op://Honeybot/{Service}-{SlackUserID}/{field}
# and is fetched at tool-invocation time by skills/_lib/creds.sh using the
# Slack user ID of the requester. These do NOT appear in .env.schema because
# (a) they are dynamic per-user and (b) keeping them out of the varlock
# pre-resolution path is what makes cross-user access a hard error rather
# than a silent fallback. See docs/identity-model.md for the full rationale.
