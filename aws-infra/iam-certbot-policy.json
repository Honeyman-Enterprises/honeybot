{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowRoute53HostedZoneList",
      "Effect": "Allow",
      "Action": [
        "route53:ListHostedZones",
        "route53:GetChange"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowRoute53RecordChangesOnHoneymanZone",
      "Effect": "Allow",
      "Action": [
        "route53:ChangeResourceRecordSets",
        "route53:ListResourceRecordSets"
      ],
      "Resource": "arn:aws:route53:::hostedzone/REPLACE_WITH_ZONE_ID"
    }
  ]
}
